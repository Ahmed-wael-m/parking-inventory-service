PORT=3002
# Set a unique INSTANCE_ID per worker, or leave empty to auto-generate.
INSTANCE_ID=
BIND_HOST=127.0.0.1
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:4566
ZONES_TABLE=ParkingZones
SPOTS_TABLE=ParkingSpots
JWT_SECRET=REPLACE_WITH_PRIVATE_SHARED_KEY
JWT_ISSUER=REPLACE_WITH_AGREED_ISSUER
JWT_AUDIENCE=REPLACE_WITH_AGREED_AUDIENCE
INVENTORY_TOKEN=REPLACE_WITH_PRIVATE_SERVICE_TOKEN
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_MAX=120
INVENTORY_SAFETY_MODE=connected

# Enable only after legacy reservation migration and exclusive hold workflow are verified.
INVENTORY_HOLDS_READY=false

# Optional distinct read-only token for Thabit; privately agree before use.
INVENTORY_LOCATION_TOKEN=
